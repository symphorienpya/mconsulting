<!doctype html>
<html lang="fr">
<head>
  <meta name="google-site-verification" content="qtVBikpn1-10AvQ1srTQrWrNuMexqlKvmUEpeAuiMt4" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administration | Mconsulting</title>
  <link rel="icon" type="image/png" href="/assets/mconculting.png">
  <link rel="stylesheet" href="/admin.css">
  <meta name="theme-color" content="#171817">
</head>
<body data-authenticated="<%= isAdmin %>" data-realtime="<%= hasSupabase %>">
  <main class="admin-shell">
    <header class="admin-header"><a href="/" class="brand"><img src="/assets/mconculting.png" alt="Mconsulting"></a><div class="header-actions"><span class="live-badge"><i></i><span id="connection-label"><%= hasSupabase ? 'EN DIRECT' : 'MODE LOCAL' %></span></span><button class="logout-button" id="logout-button" type="button">Déconnexion ↗</button></div></header>

    <section class="login-panel" id="login-panel">
      <div class="login-art"><span class="login-orbit"></span><span class="login-monogram">M</span></div>
      <div class="login-copy"><p class="overline">Espace administrateur sécurisé</p><h1>Votre bureau.<br><em>En temps réel.</em></h1><p>Centralisez vos demandes, contacts, projets et activité depuis un seul espace.</p></div>
      <form id="login-form" class="login-form"><label>Mot de passe<input type="password" name="password" required autocomplete="current-password" placeholder="••••••••••"></label><button class="primary-button" type="submit"><span>Accéder au bureau</span><b>↗</b></button><p class="form-error" id="login-error"></p></form>
    </section>

    <section class="dashboard" id="dashboard" hidden>
      <div class="dashboard-head"><div><p class="overline">Administration / Vue générale</p><h1>Bonjour,<br><em>équipe.</em></h1></div><div class="dashboard-tools"><span id="dashboard-date"></span><button class="quick-button" id="new-project-button" type="button">+ Nouveau projet</button></div></div>
      <nav class="admin-tabs" aria-label="Sections d'administration"><button class="active" data-tab="overview" type="button">Vue générale</button><button data-tab="requests" type="button">Demandes</button><button data-tab="contacts" type="button">Contacts</button><button data-tab="projects" type="button">Projets</button><button data-tab="activities" type="button">Activités</button></nav>

      <div class="tab-panel active" data-panel="overview">
        <div class="stats-grid"><article><span>Demandes</span><strong id="total-count">0</strong><small>Total reçu</small></article><article class="accent"><span>À traiter</span><strong id="new-count">0</strong><small>Nouvelle demande</small></article><article><span>En cours</span><strong id="progress-count">0</strong><small>Dossiers actifs</small></article><article><span>Contacts</span><strong id="contact-count">0</strong><small>Réseau professionnel</small></article><article><span>Projets</span><strong id="project-count">0</strong><small>Dans le portefeuille</small></article><article><span>Terminés</span><strong id="completed-project-count">0</strong><small>Livrables confirmés</small></article></div>
        <div class="overview-grid"><section class="panel"><div class="panel-heading"><div><span class="overline">Dernières demandes</span><h2>À suivre</h2></div><button class="text-button" data-go-tab="requests" type="button">Tout voir ↗</button></div><div id="overview-requests" class="compact-list"></div></section><section class="panel dark-panel"><div class="panel-heading"><div><span class="overline">Activité récente</span><h2>Maintenant</h2></div><span class="pulse-dot"></span></div><div id="overview-activities" class="timeline-list"></div></section></div>
      </div>

      <div class="tab-panel" data-panel="requests"><div class="section-toolbar"><div><p class="overline">Boîte de réception</p><h2>Demandes</h2></div><button class="filter-button export-button" data-export="requests" type="button">Exporter CSV ↓</button></div><div class="toolbar"><div class="search-wrap"><span>⌕</span><input id="search-input" type="search" placeholder="Rechercher une demande, société ou service"></div><select id="status-filter"><option value="all">Tous les statuts</option><option>Nouvelle demande</option><option>En découverte</option><option>Proposition envoyée</option><option>En cours</option><option>Terminée</option></select><select id="bulk-status" aria-label="Action sur la sélection"><option value="">Action sur la sélection</option><option>Nouvelle demande</option><option>En découverte</option><option>Proposition envoyée</option><option>En cours</option><option>Terminée</option></select><button class="filter-button" id="bulk-delete-requests" type="button">Supprimer la sélection</button></div><div class="requests-layout"><div class="panel table-panel"><div class="table-heading"><span>Dossier</span><span>Besoin</span><span>Statut</span><span>Reçu</span></div><div id="request-list"></div><div class="empty-state" id="empty-state" hidden>Aucune demande trouvée.</div></div><aside class="detail-panel panel" id="detail-panel"><div class="detail-empty">Sélectionnez un dossier pour voir ses détails.</div></aside></div></div>
      <div class="tab-panel" data-panel="contacts"><div class="section-toolbar"><div><p class="overline">Carnet professionnel</p><h2>Contacts</h2></div><div class="toolbar-buttons"><button class="filter-button export-button" data-export="contacts" type="button">Exporter CSV ↓</button><button class="quick-button" id="new-contact-button" type="button">+ Ajouter un contact</button></div></div><div id="contact-grid" class="card-grid"></div><div class="empty-state" id="contacts-empty" hidden>Aucun contact enregistré.</div></div>
      <div class="tab-panel" data-panel="projects"><div class="section-toolbar"><div><p class="overline">Portefeuille</p><h2>Projets</h2></div><div class="toolbar-buttons"><button class="filter-button export-button" data-export="projects" type="button">Exporter CSV ↓</button><button class="quick-button" id="new-project-button-2" type="button">+ Nouveau projet</button></div></div><div id="project-grid" class="card-grid"></div><div class="empty-state" id="projects-empty" hidden>Aucun projet enregistré.</div></div>
      <div class="tab-panel" data-panel="activities"><div class="section-toolbar"><div><p class="overline">Journal complet</p><h2>Activités</h2></div><button class="filter-button export-button" data-export="activities" type="button">Exporter CSV ↓</button></div><div class="activity-table"><div class="activity-heading"><span>Événement</span><span>Référence</span><span>Date</span></div><div id="activity-list"></div></div></div>
    </section>
  </main>

  <dialog class="editor-dialog" id="editor-dialog"><form id="editor-form"><div class="dialog-head"><div><p class="overline" id="editor-kicker">Créer</p><h2 id="editor-title">Nouvel élément</h2></div><button class="close-dialog" type="button" aria-label="Fermer">×</button></div><div id="editor-fields"></div><div class="dialog-actions"><button class="cancel-dialog" type="button">Annuler</button><button class="primary-button" type="submit">Enregistrer <span>↗</span></button></div><p class="form-error" id="editor-error"></p></form></dialog>
  <div class="admin-toast" id="admin-toast"><strong>Nouvelle demande</strong><span>Un dossier vient d'arriver en temps réel.</span></div>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script>window.MCONSULTING_CONFIG={supabaseUrl:'<%= process.env.SUPABASE_URL || "" %>',supabaseKey:'<%= process.env.SUPABASE_ANON_KEY || "" %>'};</script><script src="/admin.js"></script>
</body>
</html>
